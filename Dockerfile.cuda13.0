FROM nvidia/cuda:13.0.1-cudnn-devel-ubuntu24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    vim \
    tmux \
    htop \
    openssh-server \
    build-essential \
    libsndfile1 \
    ffmpeg \
    python3 \
    python3-venv \
    python3-dev \
    python3-pip \
    sudo \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Make python3 the default python
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Allow pip to install system-wide (PEP 668 override, standard for Docker)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install latest pip into /usr/local (leaves Debian pip untouched)
RUN python -m pip install --upgrade pip setuptools wheel --root-user-action=ignore --ignore-installed

# ============================================================
# Python ML stack (matches requirements-blackwell.lock)
# ============================================================

# PyTorch with CUDA 13.0 support (Blackwell)
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu130

# Triton (GPU kernel compiler)
RUN pip install triton

# CuPy for CUDA 13.x
RUN pip install cupy-cuda13x

# CUDA Python bindings (no cuTile — requires CUDA 13.1)
RUN pip install cuda-python

# HuggingFace ecosystem
RUN pip install transformers datasets huggingface_hub accelerate safetensors tokenizers

# Audio processing
RUN pip install soundfile librosa scipy

# ML utilities
RUN pip install numpy numba scikit-learn pandas

# Dev/profiling tools
RUN pip install pynvml streamlit

# Fix cuBLAS version mismatch: pip-installed nvidia-cublas (bundled by PyTorch)
# can conflict with the system cuBLAS from the CUDA base image.
# Removing it forces PyTorch to fall back to the matching system cuBLAS.
RUN pip uninstall -y nvidia-cublas-cu13 nvidia-cublas-cu12 2>/dev/null; \
    pip uninstall -y nvidia_cublas_cu13 nvidia_cublas_cu12 2>/dev/null; true

# ============================================================
# Claude Code (Anthropic CLI)
# ============================================================
# Install Node.js (required for Claude Code)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

# ============================================================
# OpenAI Codex CLI
# ============================================================
RUN npm install -g @openai/codex

# ============================================================
# uv (for uvx / Piazza MCP server)
# ============================================================
RUN pip install uv

# Pre-create Claude Code config with Piazza MCP (credentials set at runtime)
RUN mkdir -p /root/.claude && \
    echo '{"mcpServers":{"piazza":{"type":"stdio","command":"uvx","args":["piazza-mcp@latest"],"env":{"PIAZZA_EMAIL":"SET_ME","PIAZZA_PASSWORD":"SET_ME"}}}}' > /root/.claude.json

# ============================================================
# Workspace setup
# ============================================================
WORKDIR /workspace

# Copy the repo into the image
COPY . /workspace/edin-mls-26-spring/

# Pre-download the model weights (cache them in the image for faster startup)
# Uncomment the next line if you want weights baked into the image (~4GB larger)
# RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('zai-org/GLM-ASR-Nano-2512')"

# SSH server setup for RunPod
RUN mkdir -p /var/run/sshd && \
    echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config

# Env vars for CUDA
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

# RunPod entrypoint: start SSH and keep container alive
# Set ANTHROPIC_API_KEY and OPENAI_API_KEY as RunPod env secrets
CMD ["/bin/bash", "-c", "service ssh start && sleep infinity"]
